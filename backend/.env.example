PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/mdesign
REDIS_URL=redis://localhost:6379

CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

BREVO_API_KEY=
EMAIL_FROM=MDesign <noreply@mdesign.app>
EMAIL_WELCOME=true

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Default provider for each AI category. Options: openai-compatible | gemini | puter
# Puter.js is recommended — developer is always free; end-user uses their own Puter free quota.
AI_TEXT_PROVIDER=puter
AI_TEXT_BASE_URL=
AI_TEXT_API_KEY=
AI_TEXT_MODEL=gpt-5.4-nano

AI_IMAGE_PROVIDER=puter
AI_IMAGE_BASE_URL=
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=flux
AI_IMAGE_SIZE=1024x1024

AI_DESIGN_PROVIDER=puter
AI_DESIGN_BASE_URL=
AI_DESIGN_API_KEY=
AI_DESIGN_MODEL=gpt-5.4-nano

AI_VISION_PROVIDER=puter
AI_VISION_BASE_URL=
AI_VISION_API_KEY=
AI_VISION_MODEL=gemini-3.6-flash
# Puter.js config (used when AI_*_PROVIDER=puter). Puter runs in the browser — no server token needed.
PUTER_ENABLED=true
PUTER_TEXT_MODEL=gpt-5.4-nano
PUTER_DESIGN_MODEL=gpt-5.4-nano
PUTER_VISION_MODEL=gemini-3.6-flash
PUTER_IMAGE_MODEL=flux
BUILD_PACE=normal

IMAGE_CONCURRENCY=3
IMAGE_MAX_RETRIES=2
IMAGE_GEN_MODE=sequential
IMAGE_POSTPROCESS=true
PLANNING_MAX_SECTIONS=12
PLANNING_REPAIR_RETRIES=2
RUN_WORKERS_IN_PROCESS=false

FIGMA_ACCESS_TOKEN=
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=http://localhost:5000/api/integrations/figma/callback
